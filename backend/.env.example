PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tempmail?retryWrites=true&w=majority
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_HEX_48
SMTP_PORT=2525
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DEFAULT_DOMAIN=example.com
INBOUND_SECRET=CHANGE_ME_INBOUND_SECRET_2026

# Cloudflare Turnstile bot verification (optional, leave empty to skip)
TURNSTILE_SECRET=CHANGE_ME_TURNSTILE_SECRET

# Stripe Payments & Premium Subscriptions (optional in dev, required for automated billing)
STRIPE_SECRET_KEY=CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_ID=CHANGE_ME_STRIPE_PRICE_ID

# NOWPayments Crypto Gateway (Optional - for cryptocurrency subscriptions)
NOWPAYMENTS_API_KEY=CHANGE_ME_NOWPAYMENTS_API_KEY
NOWPAYMENTS_IPN_SECRET=CHANGE_ME_NOWPAYMENTS_IPN_SECRET

# Firebase Authentication (Backend token verification)
FIREBASE_PROJECT_ID=CHANGE_ME_FIREBASE_PROJECT_ID
FIREBASE_API_KEY=CHANGE_ME_FIREBASE_API_KEY

# Frontend Firebase Web SDK config (Render Environment / Vite)
VITE_FIREBASE_API_KEY=CHANGE_ME_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Expected MX record substring for domain health checking (optional, default: mail)
EXPECTED_MX=mail

# Operations & Monitoring Failure Alert Webhook (optional, gets POST when failures spike > 10 in 24h)
ALERT_WEBHOOK_URL=https://your-alert-webhook.com/api/alerts

# Allowed origins for CORS (comma-separated, optional in development)
# ALLOWED_ORIGINS=https://your-app.onrender.com,https://your-custom-domain.com

# Generate secrets using either command:
# openssl rand -hex 48
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
